rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User photos - users can upload their own photos; signed-in family can read them
    match /user_photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Status memo photos and voice notes - owner writes, signed-in family can play them
    match /memo_media/{userId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
