rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a member of a bubble
    function isBubbleMember(bubbleId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bubbles.hasAny([bubbleId]);
    }
    
    // Helper function to check if user is the bubble owner
    function isBubbleOwner(bubbleId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/bubbles/$(bubbleId)) &&
             get(/databases/$(database)/documents/bubbles/$(bubbleId)).data.ownerId == request.auth.uid;
    }

    // Same checks against the post-batch state. Needed when a bubble, its
    // first node, and the owner's membership are written together.
    function isBubbleMemberAfter(bubbleId) {
      return isAuthenticated() &&
             existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.bubbles.hasAny([bubbleId]);
    }

    function isBubbleOwnerAfter(bubbleId) {
      return isAuthenticated() &&
             existsAfter(/databases/$(database)/documents/bubbles/$(bubbleId)) &&
             getAfter(/databases/$(database)/documents/bubbles/$(bubbleId)).data.ownerId == request.auth.uid;
    }

    function canAccessBubble(bubbleId) {
      return isBubbleMember(bubbleId) || isBubbleOwner(bubbleId) ||
             isBubbleMemberAfter(bubbleId) || isBubbleOwnerAfter(bubbleId);
    }

    function isValidNodeCreate() {
      return request.resource.data.userId == request.auth.uid &&
             request.resource.data.userId is string &&
             request.resource.data.tier is int &&
             request.resource.data.keys().hasAll(['userId', 'tier', 'createdAt']) &&
             (
               (request.resource.data.keys().hasAny(['name']) && request.resource.data.name is string) ||
               (request.resource.data.keys().hasAny(['fullName']) && request.resource.data.fullName is string)
             );
    }
    
    // ============================================================================
    // USERS Collection
    // ============================================================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can create their own profile
      allow create: if isOwner(userId) &&
                     request.resource.data.keys().hasAll(['fullName', 'createdAt', 'premium', 'bubbles']) &&
                     request.resource.data.fullName is string &&
                     request.resource.data.bubbles is list;
      
      // Users can update their own profile
      allow update: if isOwner(userId) &&
                     request.resource.data.fullName is string &&
                     request.resource.data.bubbles is list;
      
      // Users cannot delete their own profile (prevent accidental deletion)
      allow delete: if false;
    }
    
    // ============================================================================
    // BUBBLES Collection
    // ============================================================================
    match /bubbles/{bubbleId} {
      // Invitees can read a bubble by ID (from a join token) without listing all bubbles.
      allow get: if isAuthenticated();
      allow list: if isBubbleMember(bubbleId) || isBubbleOwner(bubbleId);
      
      // Only authenticated users can create bubbles (they become the owner)
      allow create: if isAuthenticated() &&
                     request.resource.data.ownerId == request.auth.uid &&
                     request.resource.data.keys().hasAll(['name', 'ownerId', 'createdAt']) &&
                     request.resource.data.name is string;
      
      // Owner can update any bubble fields. Joiners may only add themselves to members.
      allow update: if isBubbleOwner(bubbleId) ||
                     (
                       isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
                       (
                         !('members' in resource.data) ||
                         request.resource.data.members.hasAll(resource.data.members)
                       ) &&
                       request.resource.data.members.hasAny([request.auth.uid])
                     );
      
      // Only bubble owner can delete bubbles
      allow delete: if isBubbleOwner(bubbleId);
      
      // ============================================================================
      // NODES Subcollection
      // ============================================================================
      match /nodes/{nodeId} {
        // Invitees can read a node by ID from a pending invite. Listing stays members-only.
        allow get: if isAuthenticated();
        allow list: if isBubbleMember(bubbleId) || isBubbleOwner(bubbleId);
        
        // Owner can create the first node in the same batch as bubble creation.
        // Members can create nodes when joining. Field may be `name` or `fullName`.
        allow create: if isAuthenticated() &&
                       canAccessBubble(bubbleId) &&
                       isValidNodeCreate();
        
        // Users can update their own node, or bubble owner can update any node
        allow update: if isBubbleMember(bubbleId) &&
                       (request.resource.data.userId == request.auth.uid || isBubbleOwner(bubbleId));
        
        // Only bubble owner can delete nodes
        allow delete: if isBubbleOwner(bubbleId);
      }
      
      // ============================================================================
      // EDGES Subcollection
      // ============================================================================
      match /edges/{edgeId} {
        allow get: if isAuthenticated() &&
                     (isBubbleMember(bubbleId) || isBubbleOwner(bubbleId) ||
                      resource.data.accepted == false);

        // Collection group invite lookup cannot use get()/exists() — those
        // make Firestore reject the whole query. Constrain list to token docs
        // so joiners can query where referralToken == token before they are members.
        allow list: if isAuthenticated() && resource.data.referralToken is string;
        
        // Members can create invite edges. Field names match BubbleEdge.toFirestore().
        allow create: if canAccessBubble(bubbleId) &&
                       request.resource.data.keys().hasAll(['fromNode', 'createdAt']) &&
                       request.resource.data.fromNode is string;
        
        // Owner can update any edge. Joiners can accept a pending invite.
        allow update: if isBubbleOwner(bubbleId) || canAccessBubble(bubbleId);
        
        // Only bubble owner can delete edges
        allow delete: if isBubbleOwner(bubbleId);
      }

      // ============================================================================
      // SOS EVENTS Subcollection
      // Membership is always taken from the signed-in user's users/{uid}.bubbles
      // document. Client-supplied bubble/user IDs are not trusted.
      // ============================================================================
      match /sosEvents/{sosId} {
        allow read: if isBubbleMember(bubbleId) || isBubbleOwner(bubbleId);

        allow create: if (isBubbleMember(bubbleId) || isBubbleOwner(bubbleId)) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.bubbleId == bubbleId &&
                       request.resource.data.status == 'ACTIVE' &&
                       request.resource.data.userId is string;

        allow update: if (isBubbleMember(bubbleId) || isBubbleOwner(bubbleId)) &&
                       (
                         (
                           resource.data.userId == request.auth.uid &&
                           (
                             (
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latestLocation']) &&
                               resource.data.status in ['ACTIVE', 'ACKNOWLEDGED']
                             ) ||
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered']) ||
                             (
                               resource.data.status in ['ACTIVE', 'ACKNOWLEDGED'] &&
                               request.resource.data.status == 'RESOLVED' &&
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
                             ) ||
                             (
                               resource.data.status == 'ACTIVE' &&
                               request.resource.data.status == 'CANCELLED' &&
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
                             )
                           )
                         ) ||
                         (
                           resource.data.userId != request.auth.uid &&
                           resource.data.status == 'ACTIVE' &&
                           request.resource.data.status == 'ACKNOWLEDGED' &&
                           request.resource.data.acknowledgedBy == request.auth.uid &&
                           request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'acknowledgedAt', 'acknowledgedBy'])
                         )
                       );

        allow delete: if false;
      }

      // ============================================================================
      // FAMILY MEMOS Subcollection
      // Status and SOS board for this bubble only. Membership is server-checked.
      // ============================================================================
      match /memos/{memoId} {
        allow read: if isBubbleMember(bubbleId) || isBubbleOwner(bubbleId);

        allow create: if (isBubbleMember(bubbleId) || isBubbleOwner(bubbleId)) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.bubbleId == bubbleId &&
                       request.resource.data.type in ['status', 'sos'] &&
                       request.resource.data.userId is string;

        allow update, delete: if false;
      }
    }
    
    // ============================================================================
    // INVITATIONS Collection
    // ============================================================================
    match /invitations/{invitationId} {
      // Anyone with the token can read invitation (for joining)
      allow read: if true;
      
      // Only authenticated users can create invitations
      allow create: if isAuthenticated() &&
                     request.resource.data.keys().hasAll(['bubbleId', 'createdBy', 'createdAt', 'token']) &&
                     request.resource.data.createdBy == request.auth.uid &&
                     request.resource.data.bubbleId is string &&
                     request.resource.data.token is string;
      
      // Creator/owner can edit invites. Joiners may only mark a pending invite used.
      allow update: if isAuthenticated() &&
                     (
                       resource.data.createdBy == request.auth.uid ||
                       isBubbleOwner(resource.data.bubbleId) ||
                       (
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['accepted', 'acceptedBy', 'acceptedAt', 'used']) &&
                         request.resource.data.accepted == true
                       )
                     );
      
      // Only the creator or bubble owner can delete invitations
      allow delete: if isAuthenticated() &&
                     (resource.data.createdBy == request.auth.uid ||
                      isBubbleOwner(resource.data.bubbleId));
    }
    
    // Collection group queries on edges (invite lookup) require this recursive
    // path. Nested /bubbles/{id}/edges rules do not apply to collectionGroup().
    match /{path=**}/edges/{edgeId} {
      allow read: if isAuthenticated() && resource.data.referralToken is string;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
